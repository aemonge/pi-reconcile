{
  "name": "pi-reconcile",
  "version": "0.2.0",
  "description": "Reconcile derived artifacts (graphify graph, engram memory) at openspec work boundaries. Fail-open by design; never blocks work.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/aemonge/pi-reconcile.git"
  },
  "files": [
    "index.ts",
    "boundaries.ts",
    "executors.ts",
    "policy.ts",
    "staleness.ts",
    "sync-policy.example.json",
    "README.md",
    "LICENSE",
    "justfile"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "main": "index.ts",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node scripts/test-boundaries.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22",
    "typescript": "^5"
  }
}
